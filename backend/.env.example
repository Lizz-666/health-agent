# 数据库
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/posture_app
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 阿里云 OSS（照片上传，PHOTO_ANALYSIS_ENABLED=false 时不调用）
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=posture-app-bucket
OSS_REGION=cn-hangzhou

# DashScope AI（体态照片分析，PHOTO_ANALYSIS_ENABLED=false 时不调用）
DASHSCOPE_API_KEY=your-dashscope-api-key

# 短信
SMS_SIGN_NAME=your-sign-name
SMS_TEMPLATE_CODE=SMS_123456789

# 照片分析门禁（默认关闭，需显式启用）
PHOTO_ANALYSIS_ENABLED=false

# 照片隐私门数据生命周期（规格 §13.3/§13.4）
# 注意：这些配置项不满足隐私门启用条件，条件需要可验证的实现证据
PHOTO_RETENTION_DAYS=90
PHOTO_CONSENT_REQUIRED=true

# Purge 应用层加密（规格 §6.7）：hex 编码的 32 字节 AES-256 密钥；调用 purge 时必填；生产环境无默认值
# 生成示例：python -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM; print(AESGCM.generate_key(bit_length=256).hex())"
PURGE_ENCRYPTION_KEY=

# Hardening fix #7: versioned key ring (JSON map). Takes precedence over PURGE_ENCRYPTION_KEY when set.
# 格式: {"v1": "<64个hex字符>", "v2": "<64个hex字符>"}
# PURGE_ENCRYPTION_KEYS={"v1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}
PURGE_ENCRYPTION_KEYS=
PURGE_ACTIVE_KEY_VERSION=v1

# 开发模式
DEV_MODE=true
DEV_ADMIN_PHONE=
DEV_ADMIN_PASSWORD=

# Phase 5 Agent MVP（Task 1）：专用服务端审计 HMAC 密钥与版本。默认留空，绝非客户端/模型输入。
# 留空时 Agent 指纹能力 fail closed；密钥不入库、不入日志、不入 CI 产物、不进 Flutter defines。
# 仅在服务端配置至少 32 字节、独立于 SECRET_KEY 的真实密钥；测试只使用合成密钥。
AGENT_AUDIT_HMAC_KEY=
AGENT_AUDIT_HMAC_KEY_VERSION=

# Phase 5 Agent 云模型运行时：默认关闭。只有完成当前告知、明确同意、撤回/删除
# 路径和全部隐私门验证后才能启用。provider/model/disclosure 必须与服务端审核值一致。
AGENT_RUNTIME_ENABLED=false
AGENT_PROVIDER_ID=
AGENT_MODEL_ID=
AGENT_DISCLOSURE_VERSION=
AGENT_PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
AGENT_PROVIDER_READ_TIMEOUT_SECONDS=20
AGENT_PROVIDER_MAX_RESPONSE_BYTES=65536

# Phase 6 deterministic nutrition recommendation routes. Keep disabled until
# the release audit, migration rehearsal, and client flow are accepted.
NUTRITION_RUNTIME_ENABLED=false
