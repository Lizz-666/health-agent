{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git merge-base*": "allow",
      "git ls-files*": "allow",
      "git cat-file*": "allow",
      "git branch --show-current*": "allow",
      "git worktree list*": "allow",
      "git add*": "ask",
      "git commit*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git stash*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git worktree add*": "ask",
      "git worktree remove*": "ask",
      "git worktree prune*": "ask",
      "git branch -*": "ask",
      "git tag*": "ask",
      "git push*": "ask",
      "git push origin codex/phase4-opencode-implementation*": "ask",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git checkout --*": "deny",
      "git restore*": "ask",
      "Remove-Item *": "ask",
      "Move-Item *": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "del *": "ask",
      "rmdir *": "ask",
      "rd *": "ask",
      "docker rm*": "ask",
      "docker volume rm*": "ask",
      "docker system prune*": "deny",
      "python -m alembic downgrade*": "ask"
    }
  }
}
